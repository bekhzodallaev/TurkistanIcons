# ---- App ----
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
# Web -> API base URL used by the browser/server components.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---- Observability ----
LOG_LEVEL=info
# Sentry is a no-op stub until a DSN is provided (formalized in M11).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turkistan_icons?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=turkistan-icons
# Separate origin/bucket for sanitized user SVGs — never inlined into app HTML.
R2_SVG_BUCKET=turkistan-svg
R2_PUBLIC_BASE_URL=https://cdn.turkistanicons.com
# For local dev, point these at the MinIO service from docker-compose:
# R2_ENDPOINT=http://localhost:9000
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin
# R2_PUBLIC_BASE_URL=http://localhost:9000/turkistan-icons

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Search (optional Meilisearch in Phase 2) ----
MEILI_HOST=
MEILI_MASTER_KEY=

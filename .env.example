# ---- App ----
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turkistan_icons?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=turkistan-icons
R2_PUBLIC_BASE_URL=https://cdn.turkistanicons.com
# For local dev you can point these at MinIO:
# R2_ENDPOINT=http://localhost:9000

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Search (optional Meilisearch in Phase 2) ----
MEILI_HOST=
MEILI_MASTER_KEY=
